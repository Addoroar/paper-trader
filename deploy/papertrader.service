# systemd unit for papertrader (simulation only - places no real orders).
#
# Install (adjust User and paths):
#   sudo cp deploy/papertrader.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now papertrader
#   journalctl -u papertrader -f          # console output
#   tail -f /opt/paper-trader/logs/papertrader.jsonl
#
# SIGTERM (systemctl stop) lets the current tick finish and records a clean
# shutdown. Restart=always brings it back after a crash; the bot then detects
# the unclean shutdown and recovers on its own.

[Unit]
Description=papertrader paper-trading bot (simulation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=papertrader
WorkingDirectory=/opt/paper-trader
ExecStart=/opt/paper-trader/.venv/bin/python -m papertrader run --config /opt/paper-trader/config.yaml
Restart=always
RestartSec=10
# exit code 2 = invalid config or another instance holds the lock: don't hot-loop
RestartPreventExitStatus=2
KillSignal=SIGTERM
TimeoutStopSec=120
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
